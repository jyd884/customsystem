<view class="page">
  <view class="header">
    <view class="title">组织活力诊断结果</view>
    <view class="subtitle">从个人活力、团队活力、组织活力三个维度进行诊断</view>
  </view>

  <view class="score-card">
    <view class="company">{{company}}</view>
    <view class="score-circle-wrap">
      <view class="score-circle">
        <text class="score-val">{{organizationScore}}</text>
      </view>
      <view class="score-label">组织活力总分</view>
    </view>
    <view class="sub-score">
      <view class="sub-item">
        <view class="sub-val">{{personalScore}}</view>
        <view class="sub-name">个人活力</view>
      </view>
      <view class="sub-item">
        <view class="sub-val">{{teamScore}}</view>
        <view class="sub-name">团队活力</view>
      </view>
      <view class="sub-item">
        <view class="sub-val">{{orgScore-personalScore-teamScore}}</view>
        <view class="sub-name">组织活力</view>
      </view>
    </view>
  </view>

  <view class="tip-box">
    <text class="tip-icon">💡</text>
    <view class="tip-text">
      <text>{{company}}，您诊断分数在“{{scoreRange}}”分段，组织活力诊断结果：\n\n</text>
      <text class="level-text">▶ {{levelText}}</text>
    </view>
  </view>

  <view class="action">
    <t-button theme="primary" size="large" block bind:tap="goAdvice" t-class="shadow-btn">问题分析与建议</t-button>
    
  </view>
</view>
