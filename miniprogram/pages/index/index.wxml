<view class="page">
  <view class="header">
    <image src="../../images/logo.png" mode="aspectFit" class="logo-img" />
    <view class="title">组织活力小测试</view>
    <view class="subtitle">激活员工敬业度 提高组织活力 从调查开始</view>
  </view>

  <view class="form-card">
    <view class="field">
      <view class="field-label">您的姓名</view>
      <t-input value="{{form.name}}" placeholder="请输入姓名" data-field="name" bind:change="onInputChange" borderless="{{true}}" t-class="custom-input" />
    </view>

    <view class="field">
      <view class="field-label">您的电话</view>
      <t-input type="number" value="{{form.phone}}" placeholder="请输入电话号码" data-field="phone" bind:change="onInputChange" borderless="{{true}}" t-class="custom-input" />
    </view>

    <view class="field">
      <view class="field-label">您服务的公司全称</view>
      <t-input value="{{form.company}}" placeholder="请输入公司全称" data-field="company" bind:change="onInputChange" borderless="{{true}}" t-class="custom-input" />
    </view>

    <view class="field">
      <view class="field-label">您的职位</view>
      <t-input value="{{form.position}}" placeholder="请输入职位" data-field="position" bind:change="onInputChange" borderless="{{true}}" t-class="custom-input" />
    </view>

    <view class="field">
      <view class="field-label">公司总人数</view>
      <t-input type="number" value="{{form.employeeCount}}" placeholder="请输入人数" data-field="employeeCount" bind:change="onInputChange" borderless="{{true}}" t-class="custom-input" />
    </view>

    <view class="field">
      <view class="field-label">公司行业</view>
      <t-cell class="industry-cell" title="" note="{{form.industry || '请选择行业'}}" arrow bind:click="openIndustryPicker" t-class-note="{{form.industry ? 'industry-selected' : 'industry-placeholder'}}" />
    </view>

    <view class="tip">为生成的报表更符合您公司的现状，请认真思考后填写</view>

    <t-button theme="primary" size="large" block bind:tap="onStart" t-class="submit-btn">开始诊断</t-button>
  </view>

  <t-picker
    visible="{{industryPickerVisible}}"
    title="请选择行业"
    cancelBtn="取消"
    confirmBtn="确认"
    bind:change="onIndustryChange"
    bind:confirm="onIndustryConfirm"
    bind:cancel="onIndustryCancel"
  >
    <t-picker-item options="{{industryColumns[0]}}" />
  </t-picker>

  <t-toast id="t-toast" />
</view>