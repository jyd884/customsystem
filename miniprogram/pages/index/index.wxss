.page {
  background-color: #f9fafb;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.header {
  margin-bottom: 64rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-img {
  width: 320rpx;
  height: 96rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #6b7280;
}

.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

.field {
  margin-bottom: 32rpx;
}

.field-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 8rpx;
  text-align: left;
}

.custom-input {
  border: 1px solid #dcdcdc !important;
  border-radius: 12rpx !important;
  padding: 16rpx 24rpx !important;
}

.industry-cell {
  border: 1px solid #dcdcdc;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
}

.industry-selected {
  color: #333333 !important;
  font-size: 32rpx !important;
}

.industry-placeholder {
  color: #bbbbbb !important;
  font-size: 32rpx !important;
}

.tip {
  margin: 32rpx 0;
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
}

.submit-btn {
  border-radius: 12rpx !important;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
}
