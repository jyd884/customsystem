.page {
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.section-title {
  margin: 48rpx 0 24rpx 8rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #0052d9;
  font-size: 36rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.question-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.question {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.option-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  padding: 16rpx;
  border-radius: 16rpx;
  transition: background-color 0.2s;
}

.submit-space {
  height: 128rpx;
}

.submit-wrap {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
  z-index: 50;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.2);
  border-radius: 16rpx;
}
