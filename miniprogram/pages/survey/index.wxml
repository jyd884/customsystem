<view class="page">
  <view class="header">
    <view class="title">组织活力诊断问卷</view>
    <view class="subtitle">请根据您的真实感受选择最符合的选项</view>
  </view>

  <view class="section-title">一、个人活力</view>
  <view wx:for="{{personalQuestions}}" wx:key="id" class="question-card">
    <view class="question">{{index + 1}}. {{item.title}}</view>
    <t-radio-group value="{{answers[item.id]}}" data-id="{{item.id}}" bind:change="onAnswerChange">
      <view class="option-row">
        <t-radio wx:for="{{options}}" wx:key="value" value="{{opt.value}}" icon="line" class="option-item">
          {{opt.label}}
        </t-radio>
      </view>
    </t-radio-group>
  </view>

  <view class="section-title">二、团队活力</view>
  <view wx:for="{{teamQuestions}}" wx:key="id" class="question-card">
    <view class="question">{{index + 6}}. {{item.title}}</view>
    <t-radio-group value="{{answers[item.id]}}" data-id="{{item.id}}" bind:change="onAnswerChange">
      <view class="option-row">
        <t-radio wx:for="{{options}}" wx:key="value" value="{{opt.value}}" icon="line" class="option-item">
          {{opt.label}}
        </t-radio>
      </view>
    </t-radio-group>
  </view>

  <view class="submit-space"></view>
  <view class="submit-wrap">
    <t-button theme="primary" size="large" block bind:tap="onSubmit">提交问卷</t-button>
  </view>

  <t-toast id="t-toast" />
</view>
