<view class="page">
  <view class="header">
    <view class="status-badge">▶ {{levelText}}</view>
    <view class="title">诊断报告与建议</view>
    <view class="subtitle">基于您的问卷结果生成的定制化建议</view>
  </view>

  <view class="section-box">
    <view class="section-title">1. 结果简述</view>
    <view class="section-text">{{summary}}</view>
  </view>

  <view class="section-box">
    <view class="section-title">2. 关键问题</view>
    <view class="issue-list">
      <view wx:for="{{issues}}" wx:key="index" class="issue-item">
        <text class="issue-icon">🚫</text>
        <text class="issue-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="section-box no-border">
    <view class="section-title">3. 优化建议</view>
    <view class="advice-card short">
      <view class="advice-head">短期急救（1-2个月）</view>
      <view class="advice-list">
        <view wx:for="{{shortTerm}}" wx:key="index" class="advice-list-item">{{item}}</view>
      </view>
    </view>

    <view class="advice-card mid">
      <view class="advice-head">中期巩固（3-6个月）</view>
      <view class="advice-list">
        <view wx:for="{{midTerm}}" wx:key="index" class="advice-list-item">{{item}}</view>
      </view>
    </view>
  </view>
</view>
