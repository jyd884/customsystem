<view class="page">
  <view class="header">
    <view class="title">组织活力诊断报告</view>
    <view class="subtitle">从个人活力、团队活力、组织活力三个维度进行诊断</view>
  </view>

  <view class="score-card">
    <view class="company">{{company}}</view>
    <view class="score-circle-wrap">
      <view class="score-circle">
        <text class="score-val">{{organizationScore}}</text>
      </view>
      <view class="score-label">组织活力总分</view>
    </view>
    <view class="sub-score">
      <view class="sub-item">
        <view class="sub-val">{{personalScore}}</view>
        <view class="sub-name">个人活力</view>
      </view>
      <view class="sub-item">
        <view class="sub-val">{{teamScore}}</view>
        <view class="sub-name">团队活力</view>
      </view>
      <view class="sub-item">
        <view class="sub-val">{{organizationScore}}</view>
        <view class="sub-name">组织平均</view>
      </view>
    </view>
  </view>

  <view class="tip-box">
    <text class="tip-icon">💡</text>
    <view class="tip-text">您的组织活力处于中等偏上水平，建议重点关注团队协作效率，提升组织响应速度。</view>
  </view>

  <view class="action">
    <t-button theme="primary" size="large" block bind:tap="goAdvice" t-class="shadow-btn">生成诊断报告与建议</t-button>
  </view>
</view>
