// test.simple — Simple语言示例源文件
// 覆盖题目要求的所有单词类别：关键字、分隔符、运算符、标识符、无符号数

/* 块注释示例
   多行注释不会产生任何 token */

// 题目给定的示例（第三部分输出演示）
for(int i=0;i<5;i++) {sum +=i;} //这是有问题的循环

// 关键字测试
if (x == 0) {
    return void;
}
while (flag != false) {
    do {
        break;
    } while (true);
}
continue;

// 运算符测试（多字符运算符最长匹配）
a = b + c - d * e / f % g;
x += 1;
y -= 2;
z *= 3;
w /= 4;
p++;
q--;
r == s;
t != u;
v <= w;
x2 >= y2;
ok && flag;
a || b;
!done;

// 标识符与关键字区分
forked = 1;        // 标识符（不是关键字 for）
integer = 2;       // 标识符（不是关键字 int）
_tmp = 3;          // 下划线开头的标识符
id123 = 4;

// 无符号数测试
n1 = 0;
n2 = 42;
n3 = 3.14;
n4 = .5;
n5 = 3e5;
n6 = 3.14e+2;
n7 = .5e-10;
n8 = 100E3;
n9 = 2.0e0;

// float 关键字与浮点数并存
float pi = 3.14159;
int count = 100;
